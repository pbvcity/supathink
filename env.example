# supathink 超限思考 —— 资源底座配置(安装时若 ~/.supathink/env 不存在,会从本文件拷贝)
# 修改即时生效(每次 hook 读取),无需重启

# ---- 是否自动开启(用户级默认)----
# false:默认关,仅 /st:slow 命令、/st:on 会话开关、或项目级 .supathink.json {"auto":true} 时生效
# true :所有会话由 Router 按需分档(off/light/full),不是全开
SUPATHINK_AUTO=false

# ---- 快审(Critic)后端 ----
# 注释/留空/auto = 自动:配置了可用的 DeepSeek key 就用 deepseek(单次 3–6s,推荐),
#                  否则回退宿主自带快模型 haiku(走订阅,30–90s)
# 也可显式指定:haiku | deepseek | gpt54mini(gpt54mini 为 Codex 宿主预留,Phase 3 接线)
# SUPATHINK_CRITIC_BACKEND=auto

# ---- DeepSeek / 任意 OpenAI 兼容端点(把 key 换成你的;不要提交进任何 git 仓库)----
SUPATHINK_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
SUPATHINK_DEEPSEEK_API_KEY=sk-FAKE-REPLACE-ME
SUPATHINK_DEEPSEEK_MODEL=deepseek-v4-flash
# SUPATHINK_DEEPSEEK_STRONG_MODEL=deepseek-v4-pro   # panel 战略席用强档

# ---- panel 席位(Phase 2;未配置的席位自动缺席。端点已按 2026-07-03 官方文档核实)----
# GLM Coding Plan(国际版 z.ai:key 在 z.ai 控制台;国内 bigmodel.cn 用 https://open.bigmodel.cn/api/anthropic;订阅 key 与按量 key 不可混用)
SUPATHINK_GLM_BASE_URL=https://api.z.ai/api/anthropic
SUPATHINK_GLM_API_KEY=
SUPATHINK_GLM_MODEL=glm-5.2
SUPATHINK_GLM_COMPAT=anthropic
# MiniMax Token Plan(国际版 minimax.io:「订阅管理→Token Plan」生成订阅专用 Key;国内用 https://api.minimaxi.com/anthropic;勿用按量 key)
SUPATHINK_MINIMAX_BASE_URL=https://api.minimax.io/anthropic
SUPATHINK_MINIMAX_API_KEY=
SUPATHINK_MINIMAX_MODEL=MiniMax-M3
SUPATHINK_MINIMAX_COMPAT=anthropic
# Gemini 怀疑席:装 CLI(npm i -g @google/gemini-cli,OAuth 免费档)即自动可用;或填 REST key:
# SUPATHINK_GEMINI_API_KEY=            # aistudio.google.com/api-keys
# SUPATHINK_GEMINI_MODEL=gemini-3.5-flash

# ---- 搜索后端(OPEN-1:配了之后 Critic 才能核 fact 类断言;Tavily/Exa 任一)----
# SUPATHINK_TAVILY_API_KEY=
